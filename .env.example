# ============================================================================
# IGNIS — Space Fire Intelligence Environment Configuration
# Duplicate this file to .env and customize values for local development.
# ============================================================================

# Backend Settings (Laptop 1)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
DEBUG=True

# CORS Configuration
# Comma-separated allowed origins for frontend communication
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NASA & External Scientific APIs
NASA_API_KEY=DEMO_KEY

# AI & LLM Provider Keys (Optional / Phase 2)
# AI_MODEL_PROVIDER=openai # or anthropic, gemini, local
# AI_API_KEY=your_api_key_here

# Frontend Settings (Laptop 2 - Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE=IGNIS — Space Fire Intelligence
