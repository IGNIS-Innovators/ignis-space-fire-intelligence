# IGNIS — Space Fire Intelligence
# .gitignore

# ----------------------------------------------------------------------------
# Environments & Secrets
# ----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
!*.env.example

# ----------------------------------------------------------------------------
# Python / Backend
# ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover

# ----------------------------------------------------------------------------
# Node / Frontend
# ----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Production build outputs
frontend/dist/
frontend/dist-ssr/
*.local

# Editor / Vite cache
.vite/
.eslintcache

# ----------------------------------------------------------------------------
# Datasets & ML Artifacts
# ----------------------------------------------------------------------------
# Ignore raw & heavy processed datasets; preserve sample templates and .gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Machine learning model weights / checkpoints
*.pt
*.pth
*.onnx
*.bin
*.h5
*.pkl
models/*
!models/.gitkeep

# ----------------------------------------------------------------------------
# OS & IDE Files
# ----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# ----------------------------------------------------------------------------
# Logs & Temporary files
# ----------------------------------------------------------------------------
*.log
logs/
tmp/
temp/

